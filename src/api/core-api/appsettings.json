{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "None"
    }
  },
  "IdentityOptions": {
    "Lockout": {
      "AllowedForNewUsers": true,
      "DefaultLockoutTimeSpanInMinutes": 15,
      "MaxFailedAccessAttempts": 10
    }
  },
  "AllowedHosts": "*",
  "JwtIssuerOptions": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": ""
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": ""
    }
  },
  "Storage": {
    "Type": "AzureBlob",
    "AzureBlob": {
    },
    "FileSystem": {
      "Location": "_Storage"
    }
  },
  "Caching": {
    "Content": {
      "SlidingExpiration": 300,
      "AbsoluteExpiration": 1800
    },
    "SystemSetting": {
      "SlidingExpiration": 0,
      "AbsoluteExpiration": 900
    },
    "Tenant": {
      "SlidingExpiration": 0,
      "AbsoluteExpiration": 1800
    }
  },
  "ResponseCompression": {
    "Enabled": true,
    "MimeTypes": [
      "application/json",
      "application/graphql-response+json",
      "application/graphql+json"
    ],
    "ExcludeMimeTypes": []
  },
  "ApplicationInsights": {
    "ConnectionString": "",
    "EnableAdaptiveSampling": false,
    "EnablePerformanceCounterCollectionModule": false
  },
  "AutomatedJobs": {
    "Enabled": 0,
    "Jobs": {
      "ChildAnonymiseJob": {
        "Type": "ECDLink.AutomatedJobs.Anonymise.ChildAnonymiseJob, ECDLink.AutomatedJobs",
        "Cron": "0 0 * * *",
        "TimeZone": "Local",
        "Enabled": 1
      },
      "ExpireInvitations": {
        "Type": "ECDLink.AutomatedJobs.DailyRunners.ExpireInvitations, ECDLink.AutomatedJobs",
        "Cron": "0 0 * * *",
        "TimeZone": "Local",
        "Enabled": 1,
        "Tenants": "*"
      },
      "DailyNotificationChecks": {
        "Type": "ECDLink.AutomatedJobs.DailyRunners.DailyNotificationChecks, ECDLink.AutomatedJobs",
        "Cron": "0 10 * * 1-5",
        "TimeZone": "Local",
        "Enabled": 1,
        "Tenants": "*"
      },
      "DailyUserSMSChecks": {
        "Type": "ECDLink.AutomatedJobs.DailyRunners.DailyUserSMSChecks, ECDLink.AutomatedJobs",
        "Cron": "0 8 * * 1-5",
        "TimeZone": "Local",
        "Enabled": 0,
        "Tenants": "*"
      },
      "WeeklyNotificationChecks": {
        "Type": "ECDLink.AutomatedJobs.DailyRunners.WeeklyNotificationChecks, ECDLink.AutomatedJobs",
        "Cron": "0 16 * * 5",
        "TimeZone": "Local",
        "Enabled": 0,
        "Tenants": "*"
      },
      "MonthlyNotificationChecks": {
        "Type": "ECDLink.AutomatedJobs.MonthlyRunners.MonthlyNotificationChecks, ECDLink.AutomatedJobs",
        "Cron": "0 0 1 * *",
        "TimeZone": "Local",
        "Enabled": 0,
        "Tenants": "*"
      },
      "Visits": {
        "Type": "ECDLink.AutomatedJobs.DailyRunners.Visits, ECDLink.AutomatedJobs",
        "Cron": "0 1 * * *",
        "TimeZone": "Local",
        "Enabled": 0,
        "Tenants": "*"
      },
      "DailyNotificationRunner": {
        "Type": "ECDLink.AutomatedJobs.DailyRunners.DailyNotificationRunner, ECDLink.AutomatedJobs",
        "Cron": "0 0 * * *",
        "TimeZone": "Local",
        "Enabled": 1,
        "Tenants": "*"
      },
      "FetchCompletedTrainingCoursesJob": {
        "Type": "ECDLink.AutomatedJobs.DailyRunners.FetchCompletedTrainingCoursesJob, ECDLink.AutomatedJobs",
        "Cron": "0 2 * * 1-7",
        "TimeZone": "Local",
        "Enabled": 1,
        "Tenants": "*"
      },
      "RemovePractitioners": {
        "Type": "ECDLink.AutomatedJobs.DailyRunners.RemovePractitioners, ECDLink.AutomatedJobs",
        "Cron": "0 0 * * *",
        "TimeZone": "Local",
        "Enabled": 1
      },
      "RevertReassignment": {
        "Type": "ECDLink.AutomatedJobs.DailyRunners.RevertReassignment, ECDLink.AutomatedJobs",
        "Cron": "5 0 * * *",
        "TimeZone": "Local",
        "Enabled": 1
      },
      "PractitionerSignatureResizeJob": {
        "Type": "ECDLink.AutomatedJobs.Jobs.PractitionerSignatureResizeJob, ECDLink.AutomatedJobs",
        "Cron": "0 1 * * *",
        "TimeZone": "Local",
        "Enabled": 0
      },
      "UserProfileImageResizeJob": {
        "Type": "ECDLink.AutomatedJobs.Jobs.UserProfileImageResizeJob, ECDLink.AutomatedJobs",
        "Cron": "0 1 * * *",
        "TimeZone": "Local",
        "Enabled": 0
      }
    }
  }
}
