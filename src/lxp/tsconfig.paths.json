{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@enums/*": ["./enums/*"],
      "@hooks/*": ["./hooks/*"],
      "@models/*": ["./models/*"],
      "@schemas/*": ["./schemas/*"],
      "@services/*": ["./services/*"],
      "@store/*": [
        "./store/*", "./store"
      ],
      "@store": ["./store"],
      "@utils/*": ["./utils/*"],
      "@routes/*": ["./routes/*"],
      "@routes": ["./routes"]
    }
  }
}
