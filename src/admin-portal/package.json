{
  "name": "admin-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tailwind:build": "tailwindcss -i ./src/styles.css -o ./src/styles.generated.css --minify",
    "tailwind:watch": "tailwindcss -i ./src/styles.css -o ./src/styles.generated.css --watch",
    "start": "yarn tailwind:build && concurrently -k -n tw,cra -c magenta,cyan \"yarn tailwind:watch\" \"cross-env-shell NODE_OPTIONS=--openssl-legacy-provider craco start\"",
    "build": "yarn tailwind:build && craco build"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-upload": "^32.0.0",
    "@ecdlink/core": "^1.0.0",
    "@ecdlink/graphql": "^1.0.0",
    "@ecdlink/ui": "^1.0.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
