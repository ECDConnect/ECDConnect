 absentees {\n              absentDate\n              absentDateEnd\n              className\n              classroomGroupId\n              reason\n              reassignedToPerson\n              reassignedToUserId\n              absenteeId\n              loggedByPerson\n              loggedByUserId\n          }\n          }\n        }\n      &quot;,&quot;variables&quot;:{&quot;userId&quot;:&quot;${userid}&quot;}}</stringProp>
